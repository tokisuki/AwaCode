QMainWindow,
QWidget#appRoot {
  background-color: #f3f4f6;
  color: #20242c;
  font-family: "Segoe UI", "Microsoft YaHei UI";
  font-size: 13px;
}

QWidget#sessionRail,
QWidget#activityRail {
  background-color: #f8f9fb;
  border: 1px solid #dfe2e8;
  border-radius: 14px;
}

QWidget#conversationPane {
  background-color: #ffffff;
  border: 1px solid #dfe2e8;
  border-radius: 14px;
}

QLabel#brandName {
  color: #20242c;
  font-size: 18px;
  font-weight: 700;
}

QLabel#brandCaption,
QLabel#messageStateLabel {
  color: #7b818c;
  font-size: 11px;
}

QLabel#messageRoleLabel {
  color: #69707d;
  font-size: 10px;
  font-weight: 700;
}

QScrollArea#conversationView,
QScrollArea#conversationView > QWidget > QWidget#conversationContent {
  background-color: #ffffff;
  border: none;
}

QFrame#messageBubble {
  background-color: #eceef2;
  border: 1px solid #dfe2e8;
  border-radius: 15px;
  color: #20242c;
}

QFrame#messageBubble[messageRole="user"] {
  background-color: #496fe3;
  border-color: #496fe3;
  color: #ffffff;
}

QFrame#messageBubble[messageRole="user"] QLabel {
  color: #ffffff;
}

QFrame#messageBubble[messageRole="system"] {
  background-color: #f7f8fa;
  border-color: #e7e9ee;
  color: #69707d;
}

QPlainTextEdit,
QLineEdit,
QListView {
  background-color: #ffffff;
  color: #20242c;
  border: 1px solid #d9dce3;
  border-radius: 9px;
  selection-background-color: #cfd9fb;
  selection-color: #20242c;
}

QPlainTextEdit#taskInput {
  padding: 10px 12px;
  font-size: 14px;
}

QPlainTextEdit:focus,
QLineEdit:focus,
QListView:focus {
  border: 1px solid #6f87dc;
}

QListView {
  padding: 4px;
  outline: none;
}

QListView::item {
  border-radius: 7px;
  padding: 8px 7px;
}

QListView::item:selected {
  background-color: #e5eafb;
  color: #2d438f;
}

QPushButton {
  min-height: 30px;
  padding: 0 12px;
  background-color: #ffffff;
  color: #343944;
  border: 1px solid #d5d8df;
  border-radius: 8px;
}

QPushButton:hover {
  background-color: #f3f5fa;
  border-color: #b8beca;
}

QPushButton:focus {
  border: 1px solid #6f87dc;
}

QPushButton:disabled {
  background-color: #f0f1f3;
  color: #a5a9b1;
  border-color: #e1e3e7;
}

QPushButton#primaryAction {
  min-width: 84px;
  background-color: #496fe3;
  color: #ffffff;
  border-color: #496fe3;
  font-weight: 700;
}

QPushButton#primaryAction:hover {
  background-color: #3e63d4;
  border-color: #3e63d4;
}

QSplitter::handle {
  background-color: transparent;
  width: 8px;
}

QScrollBar:vertical {
  background: transparent;
  width: 9px;
  margin: 2px;
}

QScrollBar::handle:vertical {
  background: #c9cdd5;
  border-radius: 4px;
  min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}
